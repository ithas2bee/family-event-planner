# Copy to .env on the Ubuntu host. chmod 600 .env; replace every placeholder.
# Do not commit .env or put production values in this file.
# MSSQL_PID must be chosen after reviewing SQL Server licensing and database size.
# Express is production-eligible but has a 10 GB per-database limit; Standard requires a license.
MSSQL_PID=
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_SQL_ADMIN_PASSWORD
APP_DB_PASSWORD=REPLACE_WITH_STRONG_HUDDLEUP_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ISSUER=FamilyEventPlanner.Api
JWT_AUDIENCE=FamilyEventPlanner.Mobile
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=FamilyEventPlannerDb;User Id=huddleup_app;Password=${APP_DB_PASSWORD};Encrypt=True;TrustServerCertificate=True;
GOOGLE_PLACES_API_KEY=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Comma-separated browser origins, if a browser-based client needs CORS. Native mobile clients do not use CORS.
CORS_ALLOWED_ORIGINS=
